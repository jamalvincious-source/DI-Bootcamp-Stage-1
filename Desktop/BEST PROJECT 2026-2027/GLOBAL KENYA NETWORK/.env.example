DATABASE_URL="file:./js/backend/crc/prisma/dev.db"
JWT_SECRET="replace_with_a_unique_random_secret_of_at_least_32_characters"
PORT=3000
HOST=localhost
NODE_ENV=development

# Configure the Super Admin account. Password must be unique and at least 12 characters.
# Keep your real .env private; never commit or share the password.
# After changing the Prisma schema, run `npm run prisma:generate` and `npm run db:push`.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional SMTP settings for the email-code sign-in endpoint.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
