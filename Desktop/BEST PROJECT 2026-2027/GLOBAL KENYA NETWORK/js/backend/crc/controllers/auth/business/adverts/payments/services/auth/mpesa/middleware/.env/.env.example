```dotenv
# ==========================================
# GLOBAL NETWORK KENYA
# Environment Variables Example
# File: backend/.env.example
# ==========================================

# ------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------
NODE_ENV=development
PORT=3000
HOST=localhost

# Frontend URL (VS Code Live Server)
FRONTEND_ORIGIN=http://127.0.0.1:5500

# ------------------------------------------
# POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=global_network_kenya
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgresql_password

# ------------------------------------------
# JWT AUTHENTICATION
# Replace with a secure random secret of
# at least 32 characters.
# ------------------------------------------
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters

# ------------------------------------------
# PAYMENT CALLBACK SECURITY
# Replace with a separate secure random secret.
# ------------------------------------------
PAYMENT_CALLBACK_SECRET=replace_with_a_different_secure_random_secret

# ------------------------------------------
# OPTIONAL PAYMENT PROVIDER CONFIGURATION
# Add real provider credentials only when you
# implement and configure a payment integration.
# ------------------------------------------
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
```