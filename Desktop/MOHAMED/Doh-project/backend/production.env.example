# Copy these names into your secret manager or deployment environment.
# Do not commit real values or use local development credentials in production.
NODE_ENV=production
OIDC_ISSUER=https://identity.example.invalid/
OIDC_AUDIENCE=ondoa-api
OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
OIDC_MFA_AMR_VALUES=mfa,otp,webauthn
AMQP_TLS_URL=amqps://broker.example.invalid/
DATABASE_TLS_URL=postgresql://user:password@database.example.invalid:5432/ondoa?sslmode=verify-full
MONGODB_TLS_URI=mongodb+srv://user:password@cluster.example.invalid/ondoa
REDIS_TLS_URL=rediss://user:password@cache.example.invalid:6379/0
AWS_REGION=us-east-1
AWS_S3_BUCKET=private-loan-documents
AWS_S3_KMS_KEY_ID=replace-with-kms-key-arn
AWS_CONFIG_KMS_KEY_ID=replace-with-config-kms-key-arn
KONG_TLS_CERT_FILE=C:/path/to/tls.crt
KONG_TLS_KEY_FILE=C:/path/to/tls.key